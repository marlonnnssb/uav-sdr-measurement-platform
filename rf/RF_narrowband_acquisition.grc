- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nimport os\nfrom datetime import datetime\n\
      from gnuradio import gr\n\nclass blk(gr.sync_block):\n    def __init__(self,\n\
      \                 csv_path=\"logs/rf\",\n                 fs=1000,\n       \
      \          nfft=1024,\n                 fc=2.4e9,\n                 shifted=True,\n\
      \                 freq_unit=\"Mhz\",\n                 log_every_n=1,\n    \
      \             gain_db=0.0,\n                 rssi_offset_db=0.0,\n         \
      \        save_center_hz=None,\n                 save_bw_hz=5000.0):\n\n    \
      \    nfft_i = int(nfft)\n        fs_f = float(fs)\n        fc_f = float(fc)\n\
      \        shifted_b = bool(shifted)\n        log_every_n_i = int(log_every_n)\n\
      \        gain_db_f = float(gain_db)\n        rssi_offset_db_f = float(rssi_offset_db)\n\
      \        save_bw_hz_f = float(save_bw_hz)\n\n        if log_every_n_i < 1:\n\
      \            log_every_n_i = 1\n\n        gr.sync_block.__init__(\n        \
      \    self,\n            name=\"CSV Trace Logger\",\n            in_sig=[(np.float32,\
      \ nfft_i)],\n            out_sig=None\n        )\n\n        self.fs = fs_f\n\
      \        self.nfft = nfft_i\n        self.fc = fc_f\n        self.shifted =\
      \ shifted_b\n        self.freq_unit = str(freq_unit)\n        self.log_every_n\
      \ = log_every_n_i\n        self._vec_count = 0\n        self.gain_db = gain_db_f\n\
      \        self.rssi_offset_db = rssi_offset_db_f\n        self.save_bw_hz = save_bw_hz_f\n\
      \        self.save_center_hz = self.fc if save_center_hz is None else float(save_center_hz)\n\
      \n        run_tag = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n        filename\
      \ = f\"trace_{run_tag}.csv\"\n\n        csv_path_str = str(csv_path)\n     \
      \   if csv_path_str.lower().endswith(\".csv\"):\n            full_path = csv_path_str\n\
      \        else:\n            out_dir = csv_path_str\n            os.makedirs(out_dir,\
      \ exist_ok=True)\n            full_path = os.path.join(out_dir, filename)\n\n\
      \        self.csv_path = full_path\n\n        self._rebuild_keep_idx()\n\n \
      \       self.fp = open(self.csv_path, \"w\", buffering=1)\n\n        self.fp.write(f\"\
      # Fc_Hz={self.fc:.6f}\\n\")\n        self.fp.write(f\"# SaveCenter_Hz={self.save_center_hz:.6f}\\\
      n\")\n        self.fp.write(f\"# SaveBW_Hz={self.save_bw_hz:.6f}\\n\")\n   \
      \     self.fp.write(f\"# Fs_Hz={self.fs:.6f}\\n\")\n        self.fp.write(f\"\
      # NFFT={self.nfft}\\n\")\n        self.fp.write(f\"# Freq_unit={self.freq_unit}\\\
      n\")\n        self.fp.write(f\"# Shifted={self.shifted}\\n\")\n        self.fp.write(f\"\
      # log_every_n={self.log_every_n}\\n\")\n        self.fp.write(f\"# Gain_dB={self.gain_db:.2f}\\\
      n\")\n        self.fp.write(f\"# RSSI_Offset_dB={self.rssi_offset_db:.2f}\\\
      n\")\n        self.fp.write(f\"# saved_bins={len(self.keep_idx)}\\n\")\n\n \
      \       if self.freq_unit.lower() == \"mhz\":\n            header_freqs = self.freqs_kept_hz\
      \ / 1e6\n            fmt_freq = \"{:.6f}\"\n        else:\n            header_freqs\
      \ = self.freqs_kept_hz\n            fmt_freq = \"{:.0f}\"\n\n        header\
      \ = \"timestamp,\" + \",\".join(fmt_freq.format(f) for f in header_freqs) +\
      \ \"\\n\"\n        self.fp.write(header)\n\n        print(f\"[EPY] Logging to:\
      \ {self.csv_path}\")\n        print(f\"[EPY] log_every_n = {self.log_every_n}\"\
      )\n        print(f\"[EPY] saving {len(self.keep_idx)} / {self.nfft} bins around\
      \ {self.save_center_hz/1e6:.6f} MHz\")\n\n    def _freq_axis_hz(self):\n   \
      \     if self.shifted:\n            return self.fc + (np.arange(self.nfft) -\
      \ self.nfft / 2.0) * (self.fs / self.nfft)\n        else:\n            return\
      \ self.fc + np.arange(self.nfft) * (self.fs / self.nfft)\n\n    def _rebuild_keep_idx(self):\n\
      \        freqs_hz = self._freq_axis_hz()\n\n        bw = abs(self.save_bw_hz)\n\
      \        if bw <= 0:\n            mask = np.ones(self.nfft, dtype=bool)\n  \
      \      else:\n            mask = (\n                (freqs_hz >= (self.save_center_hz\
      \ - bw)) &\n                (freqs_hz <= (self.save_center_hz + bw))\n     \
      \       )\n\n        idxs = np.where(mask)[0]\n        if idxs.size == 0:\n\
      \            k0 = int(np.argmin(np.abs(freqs_hz - self.save_center_hz)))\n \
      \           idxs = np.array([k0], dtype=int)\n\n        self.keep_idx = idxs\n\
      \        self.freqs_kept_hz = freqs_hz[self.keep_idx]\n\n    def work(self,\
      \ input_items, output_items):\n        vecs = input_items[0]\n\n        for\
      \ v in vecs:\n            self._vec_count += 1\n            if (self._vec_count\
      \ % self.log_every_n) != 0:\n                continue\n\n            v_keep\
      \ = v[self.keep_idx]\n            ts = datetime.now().isoformat(timespec=\"\
      milliseconds\")\n            line = ts + \",\" + \",\".join(f\"{x:.2f}\" for\
      \ x in v_keep) + \"\\n\"\n            self.fp.write(line)\n\n        return\
      \ len(vecs)\n\n    def stop(self):\n        try:\n            self.fp.close()\n\
      \        except Exception:\n            pass\n        return True\n"
    affinity: ''
    alias: ''
    comment: ''
    csv_path: outdir
    fc: freq
    freq_unit: '"mhz"'
    fs: samp_rate
    gain_db: gain
    log_every_n: '4'
    maxoutbuf: '0'
    minoutbuf: '0'
    nfft: NFFT
    rssi_offset_db: RSSI_Offset
    save_bw_hz: '5000'
    save_center_hz: f_cw
    shifted: 'True'
  states:
    _io_cache: ('CSV Trace Logger', 'blk', [('csv_path', "'logs/rf'"), ('fs', '1000'),
      ('nfft', '1024'), ('fc', '2400000000.0'), ('shifted', 'True'), ('freq_unit',
      "'Mhz'"), ('log_every_n', '1'), ('gain_db', '0.0'), ('rssi_offset_db', '0.0'),
      ('save_center_hz', 'None'), ('save_bw_hz', '5000.0')], [('0', 'float', 1024)],
      [], '', ['csv_path', 'fc', 'freq_unit', 'fs', 'gain_db', 'log_every_n', 'nfft',
      'rssi_offset_db', 'save_bw_hz', 'save_center_hz', 'shifted'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [976, 276.0]
    rotation: 0
    state: enabled
- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self,\n                 fs=1.0,\n                 nfft=1024,\n\
      \                 fc=0.0,\n                 fcw=0.0,\n                 search_bw=5000.0,\n\
      \                 shifted=True):\n\n        self.fs = float(fs)\n        self.nfft\
      \ = int(nfft)\n        self.fc = float(fc)\n        self.fcw = float(fcw)\n\
      \        self.search_bw = float(search_bw)\n        self.shifted = bool(shifted)\n\
      \n        gr.sync_block.__init__(\n            self,\n            name=\"PeakAroundFCW\"\
      ,\n            in_sig=[(np.float32, self.nfft)],  # vetor dB\n            out_sig=[np.float32,\
      \ np.float32]   # peak_db, peak_freq_mhz\n        )\n\n    def _freq_axis_hz(self):\n\
      \        # mapeia bins -> frequencia absoluta (Hz), consistente com FFT shift\n\
      \        if self.shifted:\n            return self.fc + (np.arange(self.nfft)\
      \ - self.nfft/2.0) * (self.fs / self.nfft)\n        else:\n            return\
      \ self.fc + np.arange(self.nfft) * (self.fs / self.nfft)\n\n    def work(self,\
      \ input_items, output_items):\n        X = input_items[0]          # shape:\
      \ (nvec, nfft) em dB\n        out_db = output_items[0]    # shape: (nvec,)\n\
      \        out_fm = output_items[1]    # shape: (nvec,)\n\n        freqs_hz =\
      \ self._freq_axis_hz()\n\n        # janela de busca ao redor de fcw\n      \
      \  bw = abs(self.search_bw)\n        if bw <= 0:\n            # se bw=0, pega\
      \ o bin mais proximo de fcw\n            mask = np.ones(self.nfft, dtype=bool)\n\
      \        else:\n            mask = (freqs_hz >= (self.fcw - bw)) & (freqs_hz\
      \ <= (self.fcw + bw))\n\n        idxs = np.where(mask)[0]\n        if idxs.size\
      \ == 0:\n            # fallback: pega bin mais proximo\n            k0 = int(np.argmin(np.abs(freqs_hz\
      \ - self.fcw)))\n            idxs = np.array([k0], dtype=int)\n\n        # processa\
      \ cada vetor (frame)\n        for i in range(X.shape[0]):\n            v = X[i,\
      \ :]\n\n            sub = v[idxs]\n            k_rel = int(np.argmax(sub))\n\
      \            k = int(idxs[k_rel])\n\n            peak_db = float(v[k])\n   \
      \         peak_freq_mhz = float(freqs_hz[k] / 1e6)\n\n            out_db[i]\
      \ = peak_db\n            out_fm[i] = peak_freq_mhz\n\n        return len(out_db)\n"
    affinity: ''
    alias: ''
    comment: ''
    fc: freq
    fcw: f_cw
    fs: samp_rate
    maxoutbuf: '0'
    minoutbuf: '0'
    nfft: NFFT
    search_bw: search_BW
    shifted: 'True'
  states:
    _io_cache: ('PeakAroundFCW', 'blk', [('fs', '1.0'), ('nfft', '1024'), ('fc', '0.0'),
      ('fcw', '0.0'), ('search_bw', '5000.0'), ('shifted', 'True')], [('0', 'float',
      1024)], [('0', 'float', 1), ('1', 'float', 1)], '', ['fc', 'fcw', 'fs', 'nfft',
      'search_bw', 'shifted'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [488, 476.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"\n    Vector Moving Average\n\n    Performs a temporal moving average\
      \ independently\n    for each FFT frequency bin.\n\n    Input:\n        Vector\
      \ of nfft float32 linear-power samples.\n\n    Output:\n        Vector of nfft\
      \ float32 averaged linear-power samples.\n    \"\"\"\n\n    def __init__(self,\
      \ nfft=1024, avg_len=10):\n\n        gr.sync_block.__init__(\n            self,\n\
      \            name='Vector Moving Average',\n            in_sig=[(np.float32,\
      \ nfft)],\n            out_sig=[(np.float32, nfft)]\n        )\n\n        self.nfft\
      \ = nfft\n        self.avg_len = avg_len\n\n        # Circular buffer containing\
      \ the previous FFT frames.\n        self.buffer = np.zeros(\n            (avg_len,\
      \ nfft),\n            dtype=np.float64\n        )\n\n        # Running sum for\
      \ each frequency bin.\n        self.running_sum = np.zeros(\n            nfft,\n\
      \            dtype=np.float64\n        )\n\n        # Current circular-buffer\
      \ position.\n        self.index = 0\n\n        # Number of valid frames currently\
      \ stored.\n        self.count = 0\n\n\n    def work(self, input_items, output_items):\n\
      \n        x = input_items[0]\n        y = output_items[0]\n\n        for i in\
      \ range(len(x)):\n\n            frame = x[i].astype(np.float64)\n\n        \
      \    # Initial buffer filling.\n            if self.count < self.avg_len:\n\n\
      \                self.buffer[self.index] = frame\n                self.running_sum\
      \ += frame\n\n                self.count += 1\n\n                y[i] = (\n\
      \                    self.running_sum / self.count\n                ).astype(np.float32)\n\
      \n            # Normal moving-average operation.\n            else:\n\n    \
      \            # Remove the oldest frame.\n                self.running_sum -=\
      \ self.buffer[self.index]\n\n                # Store the new frame.\n      \
      \          self.buffer[self.index] = frame\n\n                # Add the new\
      \ frame.\n                self.running_sum += frame\n\n                # Average\
      \ the most recent avg_len frames.\n                y[i] = (\n              \
      \      self.running_sum / self.avg_len\n                ).astype(np.float32)\n\
      \n            # Advance circular-buffer index.\n            self.index += 1\n\
      \n            if self.index >= self.avg_len:\n                self.index = 0\n\
      \n        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    avg_len: avg_len
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    nfft: NFFT
  states:
    _io_cache: ('Vector Moving Average', 'blk', [('nfft', '1024'), ('avg_len', '10')],
      [('0', 'float', 1024)], [('0', 'float', 1024)], '\nVector Moving Average\n\nPerforms
      a temporal moving average independently\nfor each FFT frequency bin.\n\nInput:\n    Vector
      of nfft float32 linear-power samples.\n\nOutput:\n    Vector of nfft float32
      averaged linear-power samples.\n', ['avg_len', 'nfft'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [96, 380.0]
    rotation: 0
    state: enabled
